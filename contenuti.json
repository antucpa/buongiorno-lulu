  },
  "aforismi_proposti": [
    {
      "testo": "Le persone non sono ridicole se non quando vogliono parere o essere ciò che non sono.",
      "autore": "Giacomo Leopardi",
      "data": "2026-10-23"
    },
    {
      "testo": "Nessun vento è favorevole per il marinaio che non sa a quale porto vuol approdare.",
      "autore": "Lucio Anneo Seneca",
      "data": "2026-10-24"
    },
    {
      "testo": "Il buon senso c'era; ma se ne stava nascosto, per paura del senso comune.",
      "autore": "Alessandro Manzoni",
      "data": "2026-10-25"
    },
    {
      "testo": "Siamo tutti immersi nel fango, ma alcuni di noi guardano le stelle.",
      "autore": "Oscar Wilde",
      "data": "2026-10-26"
    },
    {
      "testo": "Forse che lo smeraldo perde del suo valore se non è lodato?",
      "autore": "Marco Aurelio",
      "data": "2026-10-27"
    },
    {
      "testo": "Ci sono quelli che sono intenzionalmente superficiali e profondi solo per caso.",
      "autore": "Emily Dickinson",
      "data": "2026-10-28"
    },
    {
      "testo": "La miseria, quando è miseria davvero, la intendono tutti: anche i ragazzi.",
      "autore": "Carlo Collodi",
      "data": "2026-10-29"
    },
    {
      "testo": "Se le vostre massime morali vi rattristano, dipende dal fatto che sono sbagliate.",
      "autore": "Robert Louis Stevenson",
      "data": "2026-10-30"
    },
    {
      "testo": "Nulla è più complicato della sincerità.",
      "autore": "Luigi Pirandello",
      "data": "2026-10-31"
    },
    {
      "testo": "L'amicizia è certamente un balsamo alle pene dell'amore deluso.",
      "autore": "Jane Austen",
      "data": "2026-11-02"
    },
    {
      "testo": "Finché si avranno passioni non si cesserà di scoprire il mondo.",
      "autore": "Cesare Pavese",
      "data": "2026-11-03"
    },
    {
      "testo": "L'ultima cosa che si pensa scrivendo un libro è sapere che cosa bisogna mettere in principio.",
      "autore": "Blaise Pascal",
      "data": "2026-11-04"
    },
    {
      "testo": "Il mondo è un bel libro, ma poco serve a chi non lo sa leggere.",
      "autore": "Carlo Goldoni",
      "data": "2026-11-05"
    },
    {
      "testo": "L'abitudine ci nasconde il vero aspetto delle cose.",
      "autore": "Michel de Montaigne",
      "data": "2026-11-06"
    },
    {
      "testo": "Tristo è quel discepolo che non avanza il suo maestro.",
      "autore": "Leonardo da Vinci",
      "data": "2026-11-07"
    },
    {
      "testo": "Se non avessimo difetti, non proveremmo tanto piacere a notare quelli degli altri.",
      "autore": "François de La Rochefoucauld",
      "data": "2026-11-08"
    },
    {
      "testo": "Io vedo, che in Francia, in Inghilterra, in Italia e per tutto il mondo le donne ne sanno una più del diavolo!",
      "autore": "Carlo Goldoni",
      "data": "2026-11-09"
    },
    {
      "testo": "La strada dell'eccesso porta al palazzo della saggezza.",
      "autore": "William Blake",
      "data": "2026-11-10"
    },
    {
      "testo": "Se lei si spiega con un esempio non capisco più niente.",
      "autore": "Ennio Flaiano",
      "data": "2026-11-11"
    },
    {
      "testo": "Scrivere è un modo di parlare senza essere interrotti.",
      "autore": "Jules Renard",
      "data": "2026-11-12"
    },
    {
      "testo": "In questo mondo, quando si può, bisogna mostrarsi cortesi con tutti, se vogliamo esser ricambiati con pari cortesia nei giorni del bisogno.",
      "autore": "Carlo Collodi",
      "data": "2026-11-13"
    }
